TELEGRAM_TOKEN=
CHANNEL_ID=@ipodevta
ADMIN_CHAT_ID=

# Instant replies (Cloudflare Worker webhook). When set, Actions stops polling.
TELEGRAM_WEBHOOK=1
WEBHOOK_BASE_URL=https://ipo-devta-bot.YOUR_SUBDOMAIN.workers.dev
WEBHOOK_SECRET=
EXPORT_SECRET=

# IPO Guru Data API v2 — server / Actions only. Never put this in the Worker
# or any browser/mobile client. Free plan: 10 req/day · 1/min (IST midnight reset).
# Default budget = full free plan. Preview/commands use disk cache (0 Guru calls).
# Category subscription (QIB/NII/Retail) comes from BSE public APIs — no Guru quota.
IPOGURU_API_KEY=
IPOGURU_BASE_URL=https://www.ipoguru.in/api/v2
IPOGURU_MAX_REQUESTS_PER_DAY=10
