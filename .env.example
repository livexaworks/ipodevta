TELEGRAM_TOKEN=
CHANNEL_ID=@ipodevta
# Only needed when CHANNEL_ID is numeric (-100...): the public t.me link.
CHANNEL_URL=
ADMIN_CHAT_ID=

# Cloudflare Worker (webhook + user filters + Check now cache).
WEBHOOK_BASE_URL=https://ipo-devta-bot.YOUR_SUBDOMAIN.workers.dev
WEBHOOK_SECRET=
# Shared secret between Actions and the Worker. Also keys the chat-id hashes in data/sent.json.
EXPORT_SECRET=

# IPO Guru Data API v2, free plan: 10 requests/day, 1/minute. Server-side only.
IPOGURU_API_KEY=
IPOGURU_MAX_REQUESTS_PER_DAY=10
